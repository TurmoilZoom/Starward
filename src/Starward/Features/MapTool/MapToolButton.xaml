<?xml version="1.0" encoding="utf-8" ?>
<!--  启动页右侧「地图工具」：点击打开站点列表，跳转浏览器  -->
<UserControl x:Class="Starward.Features.MapTool.MapToolButton"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:animatedvisuals="using:Starward.AnimatedVisuals"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:lang="using:Starward.Language"
             xmlns:local="using:Starward.Features.MapTool"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:sc="using:Starward.Controls"
             x:DefaultBindMode="OneWay"
             mc:Ignorable="d">

    <Button x:Name="Button_MapTool"
            Padding="0"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch"
            BorderThickness="0"
            CornerRadius="8"
            Loaded="Button_MapTool_Loaded"
            PointerEntered="Button_MapTool_PointerEntered"
            PointerExited="Button_MapTool_PointerExited"
            sc:InstantTooltip.Placement="Left"
            sc:InstantTooltip.Text="{x:Bind lang:Lang.MapToolButton_Title}"
            Style="{ThemeResource DateTimePickerFlyoutButtonStyle}"
            Unloaded="Button_MapTool_Unloaded">

        <!--  Lottie 地球：与相邻工具栏图标一致，32px + Margin 4，默认静止、悬浮播放  -->
        <AnimatedVisualPlayer x:Name="Lottie_MapTool"
                              Width="32"
                              Height="32"
                              Margin="4"
                              AutoPlay="False"
                              Stretch="Uniform">
            <animatedvisuals:Doodle_color_27_globe_hover_rotate />
        </AnimatedVisualPlayer>

        <Button.Flyout>
            <Flyout Placement="LeftEdgeAlignedTop"
                    FlyoutPresenterStyle="{StaticResource RightToolbarFlyoutPresenterStyle}"
                    sc:FlyoutGap.Horizontal="12">
                <Grid Width="280">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <TextBlock Margin="0,0,0,10"
                               VerticalAlignment="Center"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Text="{x:Bind lang:Lang.MapToolButton_Title}" />

                    <ItemsControl Grid.Row="1" ItemsSource="{x:Bind Options}">
                        <!--  间距放在 ItemsPanel 上：StackPanel.Spacing 只加在项与项之间，不会给最后一项留下尾巴  -->
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Spacing="6" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="local:MapToolOption">
                                <Border Padding="10,8"
                                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        Loaded="Item_Border_Loaded"
                                        PointerEntered="Item_Border_PointerEntered"
                                        PointerExited="Item_Border_PointerExited"
                                        Tapped="Item_Tapped"
                                        Tag="{x:Bind}">
                                    <Grid ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <TextBlock VerticalAlignment="Center"
                                                   FontWeight="SemiBold"
                                                   IsHitTestVisible="False"
                                                   Text="{x:Bind Title}"
                                                   TextTrimming="CharacterEllipsis"
                                                   TextWrapping="NoWrap" />

                                        <FontIcon Grid.Column="1"
                                                  VerticalAlignment="Center"
                                                  FontSize="12"
                                                  Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                                  Glyph="&#xE76C;"
                                                  IsHitTestVisible="False" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>
            </Flyout>
        </Button.Flyout>
    </Button>
</UserControl>
