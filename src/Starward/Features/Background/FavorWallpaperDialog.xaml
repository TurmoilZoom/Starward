<?xml version="1.0" encoding="utf-8" ?>
<ContentDialog x:Class="Starward.Features.Background.FavorWallpaperDialog"
               xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
               xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
               xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
               xmlns:lang="using:Starward.Language"
               xmlns:local="using:Starward.Features.Background"
               xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
               xmlns:sc="using:Starward.Controls"
               x:DefaultBindMode="OneWay"
               Background="{ThemeResource CustomAcrylicBrush}"
               BorderThickness="0"
               CornerRadius="8"
               Style="{ThemeResource DefaultContentDialogStyle}"
               mc:Ignorable="d">

    <ContentDialog.Resources>
        <Thickness x:Key="ContentDialogPadding">0</Thickness>
        <!-- 模板里空的 Title 行仍带 0,0,0,12 的下边距，不清零的话顶部会比左右多空 12。 -->
        <Thickness x:Key="ContentDialogTitleMargin">0</Thickness>
        <!-- ToggleSwitch 模板在滑块上下各留 10px 空行（10+20+10=40 高），比同行 32 的图标按钮高一截，会把整个标题行撑高并让标题被居中顶下去。 -->
        <x:Double x:Key="ToggleSwitchPreContentMargin">4</x:Double>
        <x:Double x:Key="ToggleSwitchPostContentMargin">4</x:Double>
        <x:Double x:Key="ContentDialogMaxWidth">1040</x:Double>
        <x:Double x:Key="ContentDialogMaxHeight">820</x:Double>
        <StaticResource x:Key="ContentDialogSmokeFill" ResourceKey="ControlFillColorTransparentBrush" />
        <StaticResource x:Key="ContentDialogTopOverlay" ResourceKey="ControlFillColorTransparentBrush" />
    </ContentDialog.Resources>


    <!-- 952 = 4×228(912) + 左右内边距 8×2 + 24 富余；富余留给 GridView 居中与「总是显示滚动条」时的占位，避免差几 px 掉成 3 列。 -->
    <Grid Width="952"
          MinHeight="200"
          Padding="8,8,8,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 标题行：标题、模式切换、随机模式聚成左侧一簇（都是这个画廊的控制项），右侧只留关闭按钮。 -->
        <!-- 左右各再缩 16：GridView 居中留下的 12 + 卡片自身 4 的外边距，这样标题正好对齐首列卡片的可见边。 -->
        <Grid Height="32"
              Margin="16,0,16,8"
              ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0"
                       VerticalAlignment="Center"
                       FontSize="20"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       Text="{x:Bind DialogTitle, Mode=OneWay}" />

            <Button Grid.Column="1"
                    Width="32"
                    Height="32"
                    Padding="0"
                    VerticalAlignment="Center"
                    BorderThickness="0"
                    Command="{x:Bind SwitchModeCommand}"
                    CornerRadius="8"
                    sc:InstantTooltip.Placement="Bottom"
                    sc:InstantTooltip.Text="{x:Bind SwitchTooltip, Mode=OneWay}"
                    Style="{ThemeResource DateTimePickerFlyoutButtonStyle}">
                <FontIcon FontSize="14"
                          Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                          Glyph="&#xE8AB;"
                          IsTextScaleFactorEnabled="False" />
            </Button>

            <!-- 随机模式开关：只写设置，下次「重新看到背景」（启动 / 切换游戏 / 从托盘打开主窗口）时才随机。IsOn 由 code-behind 同步，不用 TwoWay 绑定，避免加载与切换模式时误触发 Toggled。 -->
            <!-- 再加 8 与模式切换按钮拉开到 16，两组控件不粘连。 -->
            <ToggleSwitch x:Name="ToggleSwitch_Shuffle"
                          Grid.Column="2"
                          MinWidth="0"
                          Margin="8,0,0,0"
                          VerticalAlignment="Center"
                          OffContent="{x:Bind lang:Lang.FavorWallpaper_ShuffleMode}"
                          OnContent="{x:Bind lang:Lang.FavorWallpaper_ShuffleMode}"
                          Toggled="ToggleSwitch_Shuffle_Toggled" />

            <!-- 后台校验/回源时的提示（数量对不上、正在补词条）；命中缓存与首次转圈时不显示。占剩余宽度，过长时省略。 -->
            <TextBlock Grid.Column="3"
                       HorizontalAlignment="Left"
                       VerticalAlignment="Center"
                       FontSize="12"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       Text="{x:Bind FavorPanel.StatusText, Mode=OneWay}"
                       TextTrimming="CharacterEllipsis"
                       Visibility="{x:Bind FavorPanel.StatusText, Mode=OneWay, Converter={StaticResource ObjectToVisibilityConverter}}" />

            <!-- 关闭按钮不跟下方卡片对齐：负的右边距抵掉标题行的 16，贴到距边框 8 的右上角。 -->
            <Button Grid.Column="4"
                    Width="32"
                    Height="32"
                    Margin="0,0,-16,0"
                    Padding="0"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    BorderThickness="0"
                    Command="{x:Bind CloseCommand}"
                    CornerRadius="8"
                    Style="{ThemeResource DateTimePickerFlyoutButtonStyle}">
                <FontIcon FontSize="16"
                          Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                          Glyph="&#xE711;"
                          IsTextScaleFactorEnabled="False" />
            </Button>
        </Grid>

        <local:FavorWallpaperPanel x:Name="FavorPanel"
                                   Grid.Row="1"
                                   Height="520" />
    </Grid>

</ContentDialog>
